# Local development — copy to .env and adjust.
# NEVER commit your real .env file.

# PostgreSQL connection string (Railway injects this when you add the Postgres plugin)
DATABASE_URL="postgresql://user:password@host:5432/railway"

# 64-char random string. Generate: openssl rand -hex 32
SESSION_SECRET="change-me-generate-a-long-random-string-min-32-chars"

# 32+ char random string used to encrypt generated secrets at rest (e.g. VPN credentials).
# Generate: openssl rand -hex 32
ENCRYPTION_KEY="change-me-generate-another-long-random-string"

# Optional: one-time token that allows creating an extra admin via /setup after bootstrap.
# Leave unset on fresh installs — /setup is open while the database has no users.
SETUP_TOKEN=

# Optional: comma-separated allowed origin for CORS. Leave empty for same-origin only.
CORS_ORIGIN=

NODE_ENV="production"
PORT=3000
